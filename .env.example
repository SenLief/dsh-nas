# Use the lower-case GitHub owner/repository names. No Docker Hub account needed.
DSH_IMAGE=ghcr.io/senlief/dsh-nas:latest
# NAS LAN IPv4, NOT the container's IP; replace with your actual address.
NAS_IP=192.168.1.20
DSH_PORT=3080
# 1: direct access without a token; 0: restore official token/cookie login.
DSH_DISABLE_BROWSER_AUTH=1
# Relative to compose.yaml, or use your NAS's actual absolute directory path.
# Container UI uses /workspace; this is the corresponding NAS folder.
WORKSPACE_DIR=./workspace
# Optional additional browser-facing hosts, comma separated; no scheme/path.
DSH_EXTRA_TRUSTED_HOSTS=
TZ=Asia/Shanghai
